    .method-card span{font-size:11.5px;color:var(--ink-soft);line-height:1.4;display:block;}
    .form-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;box-shadow:var(--shadow-sm);}
    .balance-card{background:linear-gradient(135deg,var(--coffee-900),var(--coffee-700));color:#fff;border-radius:16px;padding:20px;position:relative;overflow:hidden;}
    .balance-card::after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;background:rgba(212,162,76,.18);}
    .section-label{display:flex;align-items:center;gap:10px;margin:20px 0 14px;padding-bottom:10px;border-bottom:1px solid var(--line);}
    .section-label::before{content:"";width:3px;height:18px;border-radius:3px;background:var(--gold-500);flex:none;}
    .section-label h4{margin:0;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--coffee-700);}
    .verify-box{margin-top:8px;padding:10px 12px;border-radius:10px;font-size:12.5px;display:none;align-items:center;gap:8px;}
    .verify-box.ok{background:var(--acacia-100);color:var(--acacia-600);border:1px solid var(--acacia-500);}
    .verify-box.err{background:var(--danger-100);color:var(--danger);border:1px solid var(--danger);}
    @media (max-width:900px){ .hero-grid{grid-template-columns:1fr;} .method-cards{grid-template-columns:1fr;} }
</style>
