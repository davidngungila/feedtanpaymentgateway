    .payout-hero{background:linear-gradient(135deg,var(--coffee-900) 0%, var(--coffee-700) 40%, #5E6E3F 100%);border-radius:20px;padding:28px;color:#fff;position:relative;overflow:hidden;margin-bottom:20px;}
    .payout-hero::before{content:"";position:absolute;right:-40px;top:-40px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle, rgba(212,162,76,.22), transparent 70%);}
    .payout-hero::after{content:"";position:absolute;left:30%;bottom:-30px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle, rgba(255,255,255,.06), transparent 70%);}
    .hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:center;position:relative;z-index:1;}
