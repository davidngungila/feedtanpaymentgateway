    .method-card:hover{border-color:var(--terracotta-500);transform:translateY(-1px);box-shadow:var(--shadow-md);}
    .method-card.active{border-color:var(--terracotta-600);background:var(--terracotta-100);box-shadow:0 4px 12px rgba(194,89,43,.15);}
    .method-card.active::after{content:"✓";position:absolute;top:10px;right:10px;width:20px;height:20px;border-radius:50%;background:var(--terracotta-600);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;}
    .method-card .ico{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;font-size:20px;}
    .method-card[data-method="simu"] .ico{background:var(--acacia-100);color:var(--acacia-600);}
